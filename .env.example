# Copia este archivo a .env.local (desarrollo) o carga las variables en Railway. Nunca subas llaves al repositorio.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://mathfra.app
# Número de WhatsApp en formato internacional, solo dígitos (wa.me)
NEXT_PUBLIC_WHATSAPP=12024577161

# --- Supabase (Postgres + Auth + RLS) ---  supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (service role / sb_secret_...). SOLO servidor.
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile (anti-bots) ---  dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Correo: Resend ---  resend.com (verifica el dominio mathfra.app)
RESEND_API_KEY=
EMAIL_FROM="Mathfra <contacto@mathfra.app>"
EMAIL_TO_BUSINESS=contacto@mathfra.com
# Secreto para firmar enlaces de baja del boletín (cadena aleatoria larga)
NEWSLETTER_TOKEN_SECRET=

# --- Pagos: Stripe Checkout (tarjeta + OXXO) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = mostrar botón de pago en /precios (requiere precios en src/content/oferta.ts)
NEXT_PUBLIC_PAYMENTS_ENABLED=0
# 1 = meses sin intereses con tarjetas participantes
STRIPE_MSI=0

# --- Analítica sin cookies: Umami (solo se carga con consentimiento de «Medición») ---
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Agente de IA (inactivo hasta tener la URL) ---
AGENTE_WEBHOOK_URL=
AGENTE_WEBHOOK_SECRET=
# Script del widget de chat (se reserva #chat-widget en el layout)
NEXT_PUBLIC_CHAT_WIDGET_SRC=
