# Copia este archivo a .env.local (desarrollo) o carga las variables en Railway. Nunca subas llaves al repositorio.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://mathfra.app
# Número de WhatsApp en formato internacional, solo dígitos (wa.me)
NEXT_PUBLIC_WHATSAPP=12024577161

# --- Supabase (Postgres + Auth + RLS) ---  supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (service role / sb_secret_...). SOLO servidor.
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile (anti-bots) ---  dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Correo: Resend ---  resend.com (verifica el dominio mathfra.app)
RESEND_API_KEY=
EMAIL_FROM="Mathfra <contacto@mathfra.app>"
EMAIL_TO_BUSINESS=contacto@mathfra.com
# Secreto para firmar enlaces de baja del boletín (cadena aleatoria larga)
NEWSLETTER_TOKEN_SECRET=

# --- Pagos: Stripe Checkout (tarjeta + OXXO) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = mostrar botón de pago en /precios (requiere precios en src/content/oferta.ts)
NEXT_PUBLIC_PAYMENTS_ENABLED=0
# 1 = meses sin intereses con tarjetas participantes
STRIPE_MSI=0

# --- Analítica sin cookies: Umami (solo se carga con consentimiento de «Medición») ---
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Agente de IA (inactivo hasta tener la URL) ---
AGENTE_WEBHOOK_URL=
AGENTE_WEBHOOK_SECRET=
# Script del widget de chat (se reserva #chat-widget en el layout)
NEXT_PUBLIC_CHAT_WIDGET_SRC=

# --- Prospección automática (servicio «prospeccion» en Railway; config: railway.prospeccion.json) ---
# Búsqueda: dashboard.exa.ai (US$10 gratis al mes). DENUE: token gratis en inegi.org.mx/servicios/api_denue.html
EXA_API_KEY=
EXA_SEARCH_TYPE=auto
DENUE_TOKEN=
# Opcionales
GOOGLE_PLACES_KEY=
MILLIONVERIFIER_KEY=
# Redacción con IA (Claude Haiku). Sin llave se usa la plantilla fija.
ANTHROPIC_API_KEY=
# Envío (Resend, ya configurado arriba). Remitente en el dominio verificado, p. ej. «Mtro. Hector · Mathfra <hector@mathfra.app>»
PROSPECCION_FROM=
PROSPECCION_REPLY_TO=
# OBLIGATORIO (LFPC art. 17): domicilio completo con calle, número, colonia, alcaldía o municipio, estado, CP y país. Sin él no sale ningún correo.
PROSPECCION_DOMICILIO=
# Cadena aleatoria de 24+ caracteres para firmar los enlaces de baja
PROSPECCION_SECRET=
# Opcional: lo que ofreces a los aliados (sin cifras ni promesas)
PROSPECCION_BENEFICIO_ALIADO=
# Correos que pueden entrar a /panel/prospeccion (separados por coma)
PROSPECCION_ADMINS=
# 1 = pausa total (no busca ni envía; las bajas se siguen procesando)
PROSPECCION_PAUSADO=
# Buzón donde llegan las respuestas (IMAP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
